{
  "name": "dsh-aside-host",
  "description": "Host gateway creating read-only Q&A side conversations (aside) under a parent session — a pure plugin for stock DeepSeek Harness",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywzhang1031/dsh-aside.git",
    "directory": "packages/aside-host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-persona": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-tool-bash": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-fs-search": "*",
    "@deepseek-ai/dsh-tool-pwsh": "*",
    "@deepseek-ai/dsh-tool-skill": "*",
    "@deepseek-ai/dsh-tool-web": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-user-approval": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-persona": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-fs": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-pwsh": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-web": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.7",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
